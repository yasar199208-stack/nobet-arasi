name: Android derleme

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Bubblewrap kur
        run: npm install -g @bubblewrap/cli

      - name: Bubblewrap ayarı
        run: |
          mkdir -p ~/.bubblewrap
          SDK="${ANDROID_SDK_ROOT:-${ANDROID_HOME:-/usr/local/lib/android/sdk}}"
          echo "{\"jdkPath\":\"$JAVA_HOME\",\"androidSdkPath\":\"$SDK\"}" > ~/.bubblewrap/config.json
          cat ~/.bubblewrap/config.json
          yes | "$SDK/cmdline-tools/latest/bin/sdkmanager" --licenses > /dev/null || true

      - name: İmza anahtarı üret
        working-directory: android
        env:
          KS_PASS: ${{ secrets.KEYSTORE_PASSWORD }}
        run: |
          if [ -z "$KS_PASS" ]; then echo "HATA: KEYSTORE_PASSWORD gizli anahtarı yok"; exit 1; fi
          keytool -genkeypair -v -keystore android.keystore -alias nobetarasi \
            -keyalg RSA -keysize 2048 -validity 10000 \
            -storepass "$KS_PASS" -keypass "$KS_PASS" \
            -dname "CN=Nobet Arasi, O=Nobet Arasi, C=TR"

      - name: Projeyi üret ve derle
        working-directory: android
        env:
          BUBBLEWRAP_KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
          BUBBLEWRAP_KEY_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
        run: |
          bubblewrap update --skipVersionUpgrade --manifest=./twa-manifest.json
          bubblewrap build --skipPwaValidation --manifest=./twa-manifest.json
          keytool -list -v -keystore android.keystore -alias nobetarasi -storepass "$BUBBLEWRAP_KEYSTORE_PASSWORD" | grep -E "SHA1|SHA256" | tee sha.txt
          ls -la

      - name: Çıktıları yükle
        uses: actions/upload-artifact@v4
        with:
          name: nobet-arasi-android
          path: |
            android/app-release-bundle.aab
            android/app-release-signed.apk
            android/android.keystore
            android/sha.txt
